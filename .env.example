# ==========================================
# OTP Share Mailbox Configuration
# ==========================================

# Your email address (e.g., yourname@gmail.com)
EMAIL_USER=

# Your email App Password (NOT your regular account password)
# For Gmail: Generate a 16-character App Password at https://myaccount.google.com/apppasswords
EMAIL_PASS=

# IMAP Server settings
# Gmail: imap.gmail.com (Port 993)
# Outlook/Hotmail: outlook.office365.com (Port 993)
# Yahoo: imap.mail.yahoo.com (Port 993)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993

# Folder to watch (Default: INBOX, or [Gmail]/All Mail, or a specific folder/label like OTP)
IMAP_FOLDER=INBOX

# Keywords to identify OTP/Verification emails (comma-separated, case-insensitive)
FILTER_KEYWORDS=otp,verification,verification code,security code,passcode,login code,one-time,confirm,verify,auth code,pin

# How often to check for new emails in seconds (default: 5)
POLL_INTERVAL=5

# Whether to mark emails as read when fetched (true/false)
MARK_AS_READ=false

# Optional security PIN for accessing the website (leave empty for no PIN)
WEB_PIN=

# Web server port and host
PORT=8000
HOST=0.0.0.0
